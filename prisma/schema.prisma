// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-1.1.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("SUPABASE_DATABASE_URL")
  directUrl = env("SUPABASE_DIRECT_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("user")
  phone             String?
  address           String?   @db.Text
  dateOfBirth       DateTime?
  age               Int?
  gender            String?
  lastEducation     String?
  institution       String?
  major             String?
  graduationYear    Int?
  gpa               Float?
  lastCompany       String?
  lastPosition      String?
  workStartDate     DateTime?
  workEndDate       DateTime?
  jobDescription    String?   @db.Text
  reasonLeaving     String?   @db.Text
  skills            String?   @db.Text
  certifications    String?   @db.Text
  portfolioUrl      String?
  linkedinUrl       String?
  isProfileComplete Boolean   @default(false)
  
  careers      Career[]      @relation("UserCareers")
  applications Application[]
  createdAt    DateTime      @default(now())
  assessmentResults AssessmentResult[]
}

model Hero {
  id          Int      @id @default(autoincrement())
  image       String   // URL gambar
  title       String?  // Opsional: Judul untuk overlay
  description String?  @db.Text // Opsional: Deskripsi singkat
  isActive    Boolean  @default(true)
  order       Int      @default(0) // Untuk mengatur urutan slide
  createdAt   DateTime @default(now())
}

model HeroContent {
  id          Int      @id @default(autoincrement())
  heading     String   @db.Text // Judul Besar
  subheading  String?  @db.Text // Tulisan kecil di bawah judul
  ctaText     String?           // Teks Tombol (misal: "Learn More")
  ctaLink     String?           // Link Tombol
  isActive    Boolean  @default(true) // Untuk menandai mana yang tampil
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Service {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @db.Text
  image       String?
  createdAt   DateTime @default(now())
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @db.Text
  location    String?
  image       String?
  date        DateTime
  createdAt   DateTime @default(now())
}

model Article {
  id          Int      @id @default(autoincrement())
  title       String
  content     String   @db.Text
  image       String?
  author      String?  // Added missing field
  createdAt   DateTime @default(now())
}

model Career {
  id           Int           @id @default(autoincrement())
  title        String
  description  String        @db.Text
  requirements String        @db.Text
  location     String
  salary       String?
  jobType      String?
  experience   String?
  status       String        @default("open") // "open" | "closed"
  
  applicants   User[]        @relation("UserCareers")
  applications Application[]
  createdAt    DateTime      @default(now())
}

model Application {
  id             Int      @id @default(autoincrement())
  userId         Int
  careerId       Int
  coverLetter    String?  @db.Text
  expectedSalary String?
  availableDate  DateTime?
  referenceContact String? @db.Text  // JSON array
  status         String   @default("pending")  // "pending", "reviewed", "interview", "accepted", "rejected"
  appliedAt      DateTime @default(now())
  reviewedAt     DateTime?
  notes          String?  @db.Text  // Notes from HR
  
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  career  Career @relation(fields: [careerId], references: [id], onDelete: Cascade)
  
  @@unique([userId, careerId])
  @@index([userId])
  @@index([careerId])
}

model Forum {
  id        Int      @id @default(autoincrement())
  quote     String   @db.Text
  author    String
  likes     Int      @default(0)
  shares    Int      @default(0)
  createdAt DateTime @default(now())
}

model AssessmentResult {
  id        Int      @id @default(autoincrement())
  userId    Int?     // Optional: link to User if they're registered
  
  // User Info (for non-registered users)
  name      String
  job       String
  city      String
  age       Int
  gender    String
  
  // Assessment Info
  type      String   // "personality" or "company"
  
  // Results (stored as JSON for flexibility)
  answers   Json     // Store all answers
  results   Json     // Store calculated results
  
  // Metadata
  createdAt DateTime @default(now())
  
  // Relations
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model Consultation {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String
  createdAt DateTime @default(now())
}

/// Komentar pengunjung untuk Article dan Event.
/// Satu tabel dipakai dua modul lewat pasangan (targetType, targetId) supaya
/// logika moderasi, anti-spam, dan panel admin tidak perlu diduplikasi.
model Comment {
  id         Int       @id @default(autoincrement())
  targetType String // "article" | "event"
  targetId   Int
  name       String
  email      String? // tidak pernah ditampilkan publik; hanya untuk moderasi
  content    String    @db.Text
  /// "approved" tayang di website, "pending" menunggu review, "rejected" ditolak.
  status     String    @default("pending")
  /// Alasan komentar masuk antrean, ditampilkan ke admin.
  flagReason String?
  /// Hash bergaram dari IP. IP mentah adalah data pribadi dan tidak disimpan.
  ipHash     String?
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?

  @@index([targetType, targetId, status])
  @@index([status, createdAt])
}

/// Like tanpa login. Deduplikasi memakai visitorKey (UUID acak milik browser),
/// bukan IP, supaya satu kantor di balik satu IP tidak dianggap satu orang.
model Reaction {
  id         Int      @id @default(autoincrement())
  targetType String // "article" | "event"
  targetId   Int
  visitorKey String
  createdAt  DateTime @default(now())

  @@unique([targetType, targetId, visitorKey])
  @@index([targetType, targetId])
}
