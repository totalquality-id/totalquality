// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("user")
  phone             String?
  address           String?   @db.Text
  dateOfBirth       DateTime?
  age               Int?
  gender            String?
  lastEducation     String?
  institution       String?
  major             String?
  graduationYear    Int?
  gpa               Float?
  lastCompany       String?
  lastPosition      String?
  workStartDate     DateTime?
  workEndDate       DateTime?
  jobDescription    String?   @db.Text
  reasonLeaving     String?   @db.Text
  skills            String?   @db.Text
  certifications    String?   @db.Text
  portfolioUrl      String?
  linkedinUrl       String?
  isProfileComplete Boolean   @default(false)
  
  careers      Career[]      @relation("UserCareers")
  applications Application[]
  createdAt    DateTime      @default(now())
}

model Service {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @db.Text
  image       String?
  createdAt   DateTime @default(now())
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @db.Text
  location    String?
  image       String?
  date        DateTime
  createdAt   DateTime @default(now())
}

model News {
  id          Int      @id @default(autoincrement())
  title       String
  content     String   @db.Text
  image       String?
  author      String?  // Added missing field
  createdAt   DateTime @default(now())
}

model Career {
  id           Int           @id @default(autoincrement())
  title        String
  description  String        @db.Text
  requirements String        @db.Text
  location     String
  salary       String?
  jobType      String?
  experience   String?
  
  applicants   User[]        @relation("UserCareers")
  applications Application[]
  createdAt    DateTime      @default(now())
}

model Application {
  id             Int      @id @default(autoincrement())
  userId         Int
  careerId       Int
  coverLetter    String?  @db.Text
  expectedSalary String?
  availableDate  DateTime?
  referenceContact String? @db.Text  // JSON array
  status         String   @default("pending")  // "pending", "reviewed", "interview", "accepted", "rejected"
  appliedAt      DateTime @default(now())
  reviewedAt     DateTime?
  notes          String?  @db.Text  // Notes from HR
  
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  career  Career @relation(fields: [careerId], references: [id], onDelete: Cascade)
  
  @@unique([userId, careerId])
  @@index([userId])
  @@index([careerId])
}

model Forum {
  id        Int      @id @default(autoincrement())
  quote     String   @db.Text
  author    String
  likes     Int      @default(0)
  shares    Int      @default(0)
  createdAt DateTime @default(now())
}