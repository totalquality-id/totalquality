# Salin ke .env hanya untuk setup baru. Jangan timpa .env yang sudah berisi credential.
# Credential database hanya untuk server, tanpa prefix NEXT_PUBLIC_.
# Ambil host/project ref dari Supabase Dashboard > Connect.
# ROLE adalah akun PostgreSQL aplikasi (proyek ini: totalquality_prisma).
# PASSWORD adalah password role database tersebut, bukan token sbp_ atau API key.
# Encode karakter khusus password dalam URL, misalnya @ menjadi %40.

# Runtime server Node/cPanel: Session pooler, port 5432, mendukung IPv4.
SUPABASE_DATABASE_URL="postgresql://ROLE.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?schema=public&sslmode=require&connection_limit=5&connect_timeout=15"

# Prisma CLI/migrasi juga menggunakan Session pooler, bukan Transaction pooler.
SUPABASE_DIRECT_URL="postgresql://ROLE.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?schema=public&sslmode=require&connection_limit=5&connect_timeout=15"
# Alternatif jika IPv6 tersedia: postgresql://ROLE:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?schema=public&sslmode=require
# Untuk runtime serverless, gunakan Transaction pooler port 6543 pada
# SUPABASE_DATABASE_URL dengan sslmode=require&pgbouncer=true&connection_limit=1.
# Pertahankan SUPABASE_DIRECT_URL di port 5432 untuk migrasi.

# Opsional: arsip koneksi MySQL untuk migrasi data; tidak digunakan aplikasi.
MYSQL_DATABASE_URL=""
JWT_SECRET=""
PORT=3000
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Prisma tidak membutuhkan project URL, anon key, service_role key, atau PAT.
# Panduan: https://supabase.com/docs/guides/database/connecting-to-postgres
